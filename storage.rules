rules_version = '2';

// Firebase Storage 보안 규칙
// 백오피스 관리자만 이미지를 업로드/삭제할 수 있도록 설정
service firebase.storage {
  match /b/{bucket}/o {

    // 학습 콘텐츠 이미지 (learning/)
    match /learning/{personality}/{imageId} {
      // 인증된 사용자만 읽기 가능
      allow read: if request.auth != null;

      // 인증된 사용자만 쓰기 가능 (업로드/삭제)
      allow write: if request.auth != null;
    }

    // 퀴즈 콘텐츠 이미지 (quiz/) - 향후 사용 가능
    match /quiz/{personality}/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // 기타 모든 파일은 기본적으로 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
